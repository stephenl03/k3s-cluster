{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Load Z-Image Turbo"},
    "inputs": {"unet_name": "Z-Image/z_image_turbo_bf16.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load Qwen3 4B text encoder"},
    "inputs": {"clip_name": "Wan2.2/qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "Load VAE"},
    "inputs": {"vae_name": "Flux/ae.safetensors"}
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {"shift": 3.0, "model": ["1", 0]}
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Size"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive prompt"},
    "inputs": {"text": "", "clip": ["2", 0]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative prompt (unused at cfg 1)"},
    "inputs": {"text": "", "clip": ["2", 0]}
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["8", 0], "vae": ["3", 0]}
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "open-webui", "images": ["9", 0]}
  }
}
